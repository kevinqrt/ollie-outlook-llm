RAG_SERVICE_URL=http://131.173.64.90:8051/
LLM_MODEL=llama3.1:70b
# VITE_BASE_API_URL bewusst nicht gesetzt: das Frontend nutzt dann seinen
# Standard-Fallback '/api', den der Vite-Dev-Server (vite.config.ts) zum
# lokalen Backend proxied. Ein direktes http://... hier bricht die Anfragen,
# weil die Task-Pane zwingend über HTTPS läuft (Office-Add-in-Vorgabe) und
# Browser HTTP-Aufrufe von einer HTTPS-Seite aus als Mixed Content blocken
# (Symptom: "Failed to fetch" ohne weitere Erklärung). Nur setzen, wenn das
# Backend selbst unter einer eigenen HTTPS-URL erreichbar ist.
MODEL_API_BASE_URL=http://localhost:18000/v1
# Nur nötig, wenn MODEL_API_BASE_URL hinter einem auth-pflichtigen Proxy
# steht (z. B. LiteLLM), der einen "sk-..."-Virtual-Key verlangt - bei einem
# rohen, unauthentifizierten DGX-Tunnel leer lassen.
MODEL_API_KEY=

# Kalenderzugriff: "ics" (Standard) liest veröffentlichte Outlook-ICS-Feeds -
# kein Azure AD/OAuth nötig. Jede Person veröffentlicht ihren eigenen Kalender
# einmalig selbst (Outlook Web -> Einstellungen -> Kalender -> Geteilte
# Kalender -> "Kalender veröffentlichen") und trägt den Link im Chat-Tab ein.
# "graph" nutzt stattdessen Microsoft Graph + eine Azure-AD-App-Registrierung
# (siehe docs/azure-ad-setup.md) - als Fallback erhalten, falls das mal
# verfügbar wird, aber nicht der Standardweg.
CALENDAR_BACKEND=ics
ICS_STORE_PATH=./ics_calendars.json

# Nur relevant, wenn CALENDAR_BACKEND=graph gesetzt ist.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_REDIRECT_URI=https://localhost:3000/auth-callback.html

# Auf true setzen, um die Kalender-Integration mit Fake-Daten zu testen,
# unabhängig vom gewählten CALENDAR_BACKEND.
CALENDAR_MOCK_MODE=false
