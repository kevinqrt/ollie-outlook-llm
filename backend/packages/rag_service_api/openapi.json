    "/": {
      "get": {
        "summary": "Browser Lab",
        "operationId": "browser_lab__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateSessionRequest": {
        "properties": {
          "documents_text": {
            "type": "string",
            "minLength": 1,
            "title": "Documents Text"
          },
          "llm_model": {
            "type": "string",
            "title": "Llm Model",
            "default": "mistral:latest"
          },
          "embedder_model": {
            "type": "string",
            "title": "Embedder Model",
            "default": "sentence-transformers/all-MiniLM-L6-v2"
          },
          "top_k": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Top K",
            "default": 4
          },
          "context_length": {
            "type": "integer",
            "maximum": 131072.0,
            "minimum": 512.0,
            "title": "Context Length",
            "default": 8192
          },
          "prompt_name": {
            "type": "string",
            "title": "Prompt Name",
            "default": "rag_short"
          }
        },
        "type": "object",
        "required": [
          "documents_text"
        ],
        "title": "CreateSessionRequest"
      },
      "DirectQueryRequest": {
        "properties": {
          "documents_text": {
            "type": "string",
            "minLength": 1,
            "title": "Documents Text"
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "title": "Query"
          },
          "llm_model": {
            "type": "string",
            "title": "Llm Model",
            "default": "mistral:latest"
          },
          "embedder_model": {
            "type": "string",
            "title": "Embedder Model",
            "default": "sentence-transformers/all-MiniLM-L6-v2"
          },
          "top_k": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Top K",
            "default": 4
          },
          "context_length": {
            "type": "integer",
            "maximum": 131072.0,
            "minimum": 512.0,
            "title": "Context Length",
            "default": 8192
          },
          "prompt_name": {
            "type": "string",
            "title": "Prompt Name",
            "default": "rag_short"
          }
        },
        "type": "object",
        "required": [
          "documents_text",
          "query"
        ],
        "title": "DirectQueryRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "QuerySessionRequest": {
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "title": "Query"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "QuerySessionRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
