        }
      }
    },
    "/sessions/{session_id}/restore": {
      "post": {
        "summary": "Restore Session",
        "operationId": "restore_session_sessions__session_id__restore_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
