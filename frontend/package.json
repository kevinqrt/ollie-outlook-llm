{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "api:generate": "openapi-typescript src/api/openapi.json -o src/api/generated/schema.d.ts",
    "api:check": "openapi-typescript src/api/openapi.json -o src/api/generated/schema.d.ts --check",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --write .",
    "preview": "vite preview",
    "validate": "npm run check && npm run typecheck"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/node": "^24.12.2",
    "@types/office-js": "^1.0.589",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.9",
    "vite-plugin-mkcert": "^2.0.0"
  }
}
