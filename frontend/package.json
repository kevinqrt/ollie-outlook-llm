{
  "name": "frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "api:generate": "openapi-ts",
    "api:check": "openapi-ts --check",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --write .",
    "preview": "vite preview",
    "validate": "npm run check && npm run typecheck"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@hey-api/client-fetch": "^0.13.1",
    "@hey-api/openapi-ts": "^0.96.1",
    "@types/node": "^24.12.2",
    "@types/office-js": "^1.0.589",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.9",
    "vite-plugin-mkcert": "^2.0.0"
  }
}
