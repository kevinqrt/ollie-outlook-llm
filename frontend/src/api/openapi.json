{
  "openapi": "3.1.0",
  "info": {
    "title": "OLLIE - Outlook Local Language Inference Engine",
    "description": "\n        Intelligent bridge orchestrating communication with the\n        [Universal RAG Service](https://github.com/detti97/universal-rag-service)\n        to provide context-aware AI email suggestions.\n        ",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Check service availability",
        "description": "Returns 'ok' status if the API service is running correctly.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseSchema"
                }
              }
            }
          }
        }
      }
    },
    "/chat": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Classical LLM chat",
        "description": "Provide a classical chat interface with history and RAG context.\n\nIf the latest user message contains a meeting request, the reply is\naugmented with real calendar availability and a concrete meeting proposal.",
        "operationId": "postChat",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequestSchema"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponseSchema"
                }
              }
            }
          },
          "503": {
            "description": "RAG Service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseSchema"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/email/suggestion": {
      "post": {
        "tags": [
          "email"
        ],
        "summary": "Generate AI email suggestion",
        "description": "Generate a professional AI-driven reply suggestion for an incoming email.\n\nIf the email contains a meeting request and the calendar is connected, the\nsuggestion is augmented with real availability so it can propose concrete times.",
        "operationId": "getEmailSuggestion",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailSuggestionRequestSchema"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The successfully generated answer suggestion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailSuggestionResponseSchema"
                }
              }
            }
          },
          "503": {
            "description": "RAG Service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseSchema"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error (e.g. empty email content)"
          }
        }
      }
    },
    "/knowledge/pdf": {
      "post": {
        "tags": [
          "knowledge"
        ],
        "summary": "Upload and index a PDF document",
        "operationId": "upload_pdf_knowledge_pdf_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_pdf_knowledge_pdf_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeUploadResponseSchema"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/knowledge/search": {
      "get": {
        "tags": [
          "knowledge"
        ],
        "summary": "Search in the knowledge base",
        "operationId": "search_knowledge_knowledge_search_get",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Query"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeSearchResponseSchema"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/knowledge/documents": {
      "get": {
        "tags": [
          "knowledge"
        ],
        "summary": "List all indexed documents",
        "operationId": "list_documents_knowledge_documents_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeDocumentListSchema"
                }
              }
            }
          }
        }
      }
    },
    "/knowledge/documents/{filename}": {
      "delete": {
        "tags": [
          "knowledge"
        ],
        "summary": "Delete a document from the knowledge base",
        "operationId": "delete_document_knowledge_documents__filename__delete",
        "parameters": [
          {
            "name": "filename",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Filename"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Delete Document Knowledge Documents  Filename  Delete"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/calendar/auth/login": {
      "get": {
        "tags": [
          "calendar"
        ],
        "summary": "Get the Microsoft login URL to connect the calendar",
        "operationId": "getCalendarAuthLogin",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUrlSchema"
                }
              }
            }
          },
          "503": {
            "description": "Graph not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseSchema"
                }
              }
            }
          }
        }
      }
    },
    "/calendar/auth/callback": {
      "post": {
        "tags": [
          "calendar"
        ],
        "summary": "Exchange an OAuth authorization code for Graph tokens",
        "operationId": "postCalendarAuthCallback",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthCallbackRequestSchema"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthStatusSchema"
                }
              }
            }
          },
          "503": {
            "description": "Token exchange failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseSchema"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/calendar/auth/status": {
      "get": {
        "tags": [
          "calendar"
        ],
        "summary": "Check whether the calendar is connected",
        "operationId": "getCalendarAuthStatus",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthStatusSchema"
                }
              }
            }
          }
        }
      }
    },
    "/calendar/events": {
      "get": {
        "tags": [
          "calendar"
        ],
        "summary": "List calendar events in a date range",
        "operationId": "getCalendarEvents",
        "parameters": [
          {
            "name": "start",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "title": "Start"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "title": "End"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarEventListSchema"
                }
              }
            }
          },
          "503": {
            "description": "Graph API unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseSchema"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/calendar/meeting-times": {
      "post": {
        "tags": [
          "calendar"
        ],
        "summary": "Find meeting times that work for all given attendees",
        "description": "Find slots where every given attendee (plus the signed-in user) is free.\n\nOnly works for attendees within the same Microsoft 365 tenant, since\nMicrosoft Graph has no visibility into external/private calendars.",
        "operationId": "postCalendarMeetingTimes",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FindMeetingTimesRequestSchema"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeetingTimeSuggestionListSchema"
                }
              }
            }
          },
          "503": {
            "description": "Graph API unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseSchema"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/calendar/ics/status": {
      "get": {
        "tags": [
          "calendar"
        ],
        "summary": "Check whether an own ICS calendar link is configured",
        "operationId": "getCalendarIcsStatus",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IcsStatusSchema"
                }
              }
            }
          },
          "503": {
            "description": "ICS backend not active",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseSchema"
                }
              }
            }
          }
        }
      }
    },
    "/calendar/ics/self": {
      "post": {
        "tags": [
          "calendar"
        ],
        "summary": "Set the signed-in user's own published-calendar ICS URL",
        "description": "Validate the given ICS feed URL by fetching it, then store it as \"my calendar\".",
        "operationId": "postCalendarIcsSelf",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetSelfIcsUrlRequestSchema"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IcsStatusSchema"
                }
              }
            }
          },
          "422": {
            "description": "URL not reachable/parseable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseSchema"
                }
              }
            }
          },
          "503": {
            "description": "ICS backend not active",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseSchema"
                }
              }
            }
          }
        }
      }
    },
    "/calendar/ics/known": {
      "get": {
        "tags": [
          "calendar"
        ],
        "summary": "List known calendar links of other people",
        "operationId": "getCalendarIcsKnown",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnownCalendarListSchema"
                }
              }
            }
          },
          "503": {
            "description": "ICS backend not active",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseSchema"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "calendar"
        ],
        "summary": "Save another person's published-calendar ICS URL",
        "operationId": "postCalendarIcsKnown",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetKnownIcsUrlRequestSchema"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnownCalendarListSchema"
                }
              }
            }
          },
          "422": {
            "description": "URL not reachable/parseable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseSchema"
                }
              }
            }
          },
          "503": {
            "description": "ICS backend not active",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseSchema"
                }
              }
            }
          }
        }
      }
    },
    "/calendar/ics/known/{email}": {
      "delete": {
        "tags": [
          "calendar"
        ],
        "summary": "Remove a saved calendar link",
        "operationId": "deleteCalendarIcsKnown",
        "parameters": [
          {
            "name": "email",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Email"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnownCalendarListSchema"
                }
              }
            }
          },
          "503": {
            "description": "ICS backend not active",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseSchema"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthCallbackRequestSchema": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "AuthCallbackRequestSchema"
      },
      "AuthStatusSchema": {
        "properties": {
          "authenticated": {
            "type": "boolean",
            "title": "Authenticated"
          }
        },
        "type": "object",
        "required": [
          "authenticated"
        ],
        "title": "AuthStatusSchema"
      },
      "AuthUrlSchema": {
        "properties": {
          "authUrl": {
            "type": "string",
            "title": "Authurl"
          }
        },
        "type": "object",
        "required": [
          "authUrl"
        ],
        "title": "AuthUrlSchema"
      },
      "Body_upload_pdf_knowledge_pdf_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_pdf_knowledge_pdf_post"
      },
      "CalendarEventListSchema": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/CalendarEventSchema"
            },
            "type": "array",
            "title": "Events"
          }
        },
        "type": "object",
        "required": [
          "events"
        ],
        "title": "CalendarEventListSchema"
      },
      "CalendarEventSchema": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "subject": {
            "type": "string",
            "title": "Subject"
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "title": "End"
          },
          "organizer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Organizer"
          },
          "isOrganizer": {
            "type": "boolean",
            "title": "Isorganizer",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "id",
          "subject",
          "start",
          "end"
        ],
        "title": "CalendarEventSchema"
      },
      "ChatMessageSchema": {
        "properties": {
          "role": {
            "type": "string",
            "title": "Role",
            "description": "The role of the message sender (e.g., 'user', 'assistant')"
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "The content of the message"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessageSchema"
      },
      "ChatRequestSchema": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessageSchema"
            },
            "type": "array",
            "title": "Messages",
            "description": "The history of the conversation"
          }
        },
        "type": "object",
        "required": [
          "messages"
        ],
        "title": "ChatRequestSchema"
      },
      "ChatResponseSchema": {
        "properties": {
          "reply": {
            "type": "string",
            "title": "Reply",
            "description": "The AI-generated reply"
          },
          "meetingProposal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MeetingProposalSchema"
              },
              {
                "type": "null"
              }
            ],
            "description": "A concrete meeting suggestion, if the message contained a meeting request."
          }
        },
        "type": "object",
        "required": [
          "reply"
        ],
        "title": "ChatResponseSchema"
      },
      "EmailSuggestionRequestSchema": {
        "properties": {
          "emailContent": {
            "type": "string",
            "minLength": 1,
            "title": "Emailcontent",
            "description": "The full text of the email for which a suggestion should be generated.",
            "examples": [
              "Hello, can we move the meeting tomorrow to 2 PM? Best regards, Max"
            ]
          },
          "attendees": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Attendees",
            "description": "Email addresses of the other recipients (To/Cc), used to check everyone's calendar availability for meeting-time suggestions.",
            "examples": [
              [
                "alice@contoso.com"
              ]
            ]
          }
        },
        "type": "object",
        "required": [
          "emailContent"
        ],
        "title": "EmailSuggestionRequestSchema"
      },
      "EmailSuggestionResponseSchema": {
        "properties": {
          "suggestedReply": {
            "type": "string",
            "title": "Suggestedreply",
            "description": "The professionally formatted answer suggestion generated by the AI.",
            "examples": [
              "Hello Max,\n\nyes, 2 PM works for me. See you tomorrow!\n\nBest regards"
            ]
          },
          "meetingProposal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MeetingProposalSchema"
              },
              {
                "type": "null"
              }
            ],
            "description": "A concrete meeting suggestion, if the email contained a meeting request."
          }
        },
        "type": "object",
        "required": [
          "suggestedReply"
        ],
        "title": "EmailSuggestionResponseSchema"
      },
      "ErrorResponseSchema": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "A detailed error message explaining what went wrong.",
            "examples": [
              "RAG Service request failed: connection timeout"
            ]
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponseSchema"
      },
      "FindMeetingTimesRequestSchema": {
        "properties": {
          "attendees": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Attendees",
            "description": "Email addresses of attendees whose calendars should be considered.",
            "examples": [
              [
                "alice@contoso.com",
                "bob@contoso.com"
              ]
            ]
          },
          "durationMinutes": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Durationminutes",
            "default": 30
          },
          "lookaheadDays": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Lookaheaddays",
            "default": 7
          }
        },
        "type": "object",
        "required": [
          "attendees"
        ],
        "title": "FindMeetingTimesRequestSchema"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponseSchema": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Current status of the backend.",
            "examples": [
              "ok"
            ]
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponseSchema"
      },
      "IcsStatusSchema": {
        "properties": {
          "configured": {
            "type": "boolean",
            "title": "Configured"
          }
        },
        "type": "object",
        "required": [
          "configured"
        ],
        "title": "IcsStatusSchema"
      },
      "KnowledgeDocumentListSchema": {
        "properties": {
          "documents": {
            "items": {
