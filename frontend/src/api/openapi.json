{
  "openapi": "3.1.0",
  "info": {
    "title": "OLLIE - Outlook Local Language Inference Engine",
    "description": "\n        Intelligent bridge orchestrating communication with the\n        [Universal RAG Service](https://github.com/detti97/universal-rag-service)\n        to provide context-aware AI email suggestions.\n        ",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Check service availability",
        "description": "Returns 'ok' status if the API service is running correctly.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseSchema"
                }
              }
            }
          }
        }
      }
    },
    "/chat": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Classical LLM chat",
        "description": "Provide a classical chat interface with history and RAG context.",
        "operationId": "postChat",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequestSchema"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponseSchema"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/email/suggestion/stream": {
      "post": {
        "tags": [
          "email"
        ],
        "summary": "Generate AI email suggestion with live pipeline progress",
        "description": "Generate a reply suggestion, streaming each pipeline step as it completes.",
        "operationId": "streamEmailSuggestion",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailSuggestionRequestSchema"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "SSE stream of pipeline steps, ending in a done or error event",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/knowledge/pdf": {
      "post": {
        "tags": [
          "knowledge"
        ],
        "summary": "Upload and index a PDF document",
        "operationId": "upload_pdf_knowledge_pdf_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_pdf_knowledge_pdf_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeUploadResponseSchema"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/knowledge/search": {
      "get": {
        "tags": [
          "knowledge"
        ],
        "summary": "Search in the knowledge base",
        "operationId": "search_knowledge_knowledge_search_get",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Query"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeSearchResponseSchema"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/knowledge/documents": {
      "get": {
        "tags": [
          "knowledge"
        ],
        "summary": "List all indexed documents",
        "operationId": "list_documents_knowledge_documents_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeDocumentListSchema"
                }
              }
            }
          }
        }
      }
    },
    "/knowledge/documents/{filename}": {
      "delete": {
        "tags": [
          "knowledge"
        ],
        "summary": "Delete a document from the knowledge base",
        "operationId": "delete_document_knowledge_documents__filename__delete",
        "parameters": [
          {
            "name": "filename",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Filename"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Delete Document Knowledge Documents  Filename  Delete"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_upload_pdf_knowledge_pdf_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_pdf_knowledge_pdf_post"
      },
      "ChatMessageSchema": {
        "properties": {
          "role": {
            "type": "string",
            "title": "Role",
            "description": "The role of the message sender (e.g., 'user', 'assistant')"
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "The content of the message"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessageSchema"
      },
      "ChatRequestSchema": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessageSchema"
            },
            "type": "array",
            "title": "Messages",
            "description": "The history of the conversation"
          }
        },
        "type": "object",
        "required": [
          "messages"
        ],
        "title": "ChatRequestSchema"
      },
      "ChatResponseSchema": {
        "properties": {
          "reply": {
            "type": "string",
            "title": "Reply",
            "description": "The AI-generated reply"
          }
        },
        "type": "object",
        "required": [
          "reply"
        ],
        "title": "ChatResponseSchema"
      },
      "EmailSuggestionRequestSchema": {
        "properties": {
          "emailContent": {
            "type": "string",
            "minLength": 1,
            "title": "Emailcontent",
            "description": "The full text of the email for which a suggestion should be generated.",
            "examples": [
              "Hello, can we move the meeting tomorrow to 2 PM? Best regards, Max"
            ]
          }
        },
        "type": "object",
        "required": [
          "emailContent"
        ],
        "title": "EmailSuggestionRequestSchema"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponseSchema": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Current status of the backend.",
            "examples": [
              "ok"
            ]
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponseSchema"
      },
      "KnowledgeDocumentListSchema": {
        "properties": {
          "documents": {
            "items": {
              "$ref": "#/components/schemas/KnowledgeDocumentSchema"
            },
            "type": "array",
            "title": "Documents",
            "description": "List of all indexed documents."
          }
        },
        "type": "object",
        "required": [
          "documents"
        ],
        "title": "KnowledgeDocumentListSchema"
      },
      "KnowledgeDocumentSchema": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source",
            "description": "The source filename of the document."
          }
        },
        "type": "object",
        "required": [
          "source"
        ],
        "title": "KnowledgeDocumentSchema"
      },
      "KnowledgeSearchResponseSchema": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/KnowledgeSearchResultSchema"
            },
            "type": "array",
            "title": "Results",
            "description": "Search results from the vector store."
          }
        },
        "type": "object",
        "required": [
          "results"
        ],
        "title": "KnowledgeSearchResponseSchema"
      },
      "KnowledgeSearchResultSchema": {
        "properties": {
          "content": {
            "type": "string",
            "title": "Content",
            "description": "The content snippet from the document."
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata",
            "description": "Additional metadata for the result."
          }
        },
        "type": "object",
        "required": [
          "content",
          "metadata"
        ],
        "title": "KnowledgeSearchResultSchema"
      },
      "KnowledgeUploadResponseSchema": {
        "properties": {
          "filename": {
            "type": "string",
            "title": "Filename",
            "description": "The name of the successfully uploaded and indexed file."
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "indexed"
          }
        },
        "type": "object",
        "required": [
          "filename"
        ],
        "title": "KnowledgeUploadResponseSchema"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
