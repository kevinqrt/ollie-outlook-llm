{
  "openapi": "3.1.0",
  "info": {
    "title": "OLLIE - Outlook Local Language Inference Engine",
    "description": "\n        Intelligent bridge orchestrating communication with the\n        [Universal RAG Service](https://github.com/detti97/universal-rag-service)\n        to provide context-aware AI email suggestions.\n        ",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Check service availability",
        "description": "Returns 'ok' status if the API service is running correctly.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseSchema"
                }
              }
            }
          }
        }
      }
    },
    "/api/email/suggestion": {
      "post": {
        "tags": [
          "email"
        ],
        "summary": "Generate AI email suggestion",
        "description": "Generate a professional AI-driven reply suggestion for an incoming email.",
        "operationId": "getEmailSuggestion",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailSuggestionRequestSchema"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The successfully generated answer suggestion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailSuggestionResponseSchema"
                }
              }
            }
          },
          "503": {
            "description": "RAG Service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseSchema"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error (e.g. empty email content)"
          }
        }
      }
    },
    "/api/email/suggestion/stream": {
      "post": {
        "tags": [
          "email"
        ],
        "summary": "Generate AI email suggestion with live pipeline progress",
        "description": "Generate a reply suggestion, streaming each pipeline step as it completes.",
        "operationId": "streamEmailSuggestion",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailSuggestionRequestSchema"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "SSE stream of pipeline steps, ending in a done or error event",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EmailSuggestionRequestSchema": {
        "properties": {
          "emailContent": {
            "type": "string",
            "minLength": 1,
            "title": "Emailcontent",
            "description": "The full text of the email for which a suggestion should be generated.",
            "examples": [
              "Hello, can we move the meeting tomorrow to 2 PM? Best regards, Max"
            ]
          }
        },
        "type": "object",
        "required": [
          "emailContent"
        ],
        "title": "EmailSuggestionRequestSchema"
      },
      "EmailSuggestionResponseSchema": {
        "properties": {
          "suggestedReply": {
            "type": "string",
            "title": "Suggestedreply",
            "description": "The professionally formatted answer suggestion generated by the AI.",
            "examples": [
              "Hello Max,\n\nyes, 2 PM works for me. See you tomorrow!\n\nBest regards"
            ]
          }
        },
        "type": "object",
        "required": [
          "suggestedReply"
        ],
        "title": "EmailSuggestionResponseSchema"
      },
      "ErrorResponseSchema": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "A detailed error message explaining what went wrong.",
            "examples": [
              "RAG Service request failed: connection timeout"
            ]
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponseSchema"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponseSchema": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Current status of the backend.",
            "examples": [
              "ok"
            ]
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponseSchema"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
